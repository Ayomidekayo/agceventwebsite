    "@prisma/client": "7.8.0",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.6.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
